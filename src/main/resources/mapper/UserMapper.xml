    <select id="getUserById" resultType="com.example.demo.entity.User">
        select * from user where id=#{id}
    </select>
    <select id="getUserByPhone" resultType="com.example.demo.entity.User">
        select * from user where phone= #{phone}
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into user(username,avatar,phone) values(#{username},#{avatar},#{phone})
    </insert>
    <update id="updateById">
        update user set username=#{username},avatar=#{avatar},password=#{password},phone=#{phone} where id=#{id}
    </update>
    <update id="updatePay" parameterType="int">
        update user set score=score+#{num} where id=#{uid}
    </update>
</mapper>