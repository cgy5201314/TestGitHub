<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.FilmMapper">

    <select id="getFilmById" resultType="com.example.demo.entity.Film">
        select * from film where id=#{id} and deleted=1
    </select>
    <select id="getAllFilm" resultType="com.example.demo.entity.Film">
        select * from film where deleted=1
    </select>
    <insert id="addFilm" parameterType="com.example.demo.entity.Film">
        insert into film(title,content,img) values(#{title},#{content},#{img})
    </insert>
    <update id="deleteFilmById" parameterType="com.example.demo.entity.Film">
        update film set deleted=0 where id=#{id}
    </update>
</mapper>