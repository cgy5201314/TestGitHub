<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.CollecterMapper">
    <select id="getAll" resultType="Collecter">
        SELECT * FROM collection where deleted=1
    </select>
    <update id="deleteById">
        update collection SET deleted=0,facetoken=null where id=#{id}
    </update>
    <insert id="insert" parameterType="Collecter">
        insert into collection(avatar,name,area,facetoken, time,uid) values(#{avatar},#{name},#{area},#{facetoken},#{time},#{uid})
    </insert>
    <select id="getById" resultType="Collecter">
        SELECT * FROM collection where id=#{id}
    </select>


</mapper>